# DNAnything — Environment Variables
#
# Copy this file to .env and fill in the values.
# NEVER commit .env or service-role keys to git.

# Supabase (recommended backend — see docs/plans/BACKEND_DATABASE_RESEARCH.md)
# Get these from your Supabase project dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service role key — for migrations/admin only. NEVER ship to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database connection string (used by Drizzle for server-side data access)
# For Supabase: postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# For Neon:     postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname
DATABASE_URL=postgresql://postgres:password@localhost:5432/dnanything

# GitHub OAuth (for Supabase Auth)
GITHUB_OAUTH_CLIENT_ID=your-client-id
GITHUB_OAUTH_CLIENT_SECRET=your-client-secret
